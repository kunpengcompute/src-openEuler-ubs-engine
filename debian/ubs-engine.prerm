#!/bin/bash
set -e

SERVICE_NAME="ubse.service"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop "$SERVICE_NAME" >/dev/null 2>&1 || true
    fi
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper disable "$SERVICE_NAME" >/dev/null 2>&1 || true
    fi
fi