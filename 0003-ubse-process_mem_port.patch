+void ProcessMemPidInfoManager::GetAllPidInfo(std::vector<def::ProcessMemPidInfo>& pidInfos)
+{
+    std::shared_lock<std::shared_mutex> lock(pidInfoMutex);
+    for (auto [key, value] : pidInfoMap) {
+        pidInfos.push_back(value);
+    }
+    return;
+}
