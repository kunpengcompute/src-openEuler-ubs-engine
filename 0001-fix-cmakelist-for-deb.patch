From f642de1944288a8788e1e9e29534768aedee1947 Mon Sep 17 00:00:00 2001
From: zhang_qin_5 <zhangqin99@h-partners.com>
Date: Tue, 2 Jun 2026 18:58:31 +0800
Subject: [PATCH] hcom提供deb包，去除源码编译hcom逻辑

---
 3rdparty/cpp-httplib/CMakeLists.txt |  3 +-
 3rdparty/hcom/CMakeLists.txt        | 43 +++--------------------------
 2 files changed, 6 insertions(+), 40 deletions(-)

diff --git a/3rdparty/cpp-httplib/CMakeLists.txt b/3rdparty/cpp-httplib/CMakeLists.txt
index 52c687ee..d185b7f8 100644
--- a/3rdparty/cpp-httplib/CMakeLists.txt
+++ b/3rdparty/cpp-httplib/CMakeLists.txt
@@ -6,7 +6,7 @@ find_path(CPPHTTPLIB_INCLUDE_DIR
 
 find_library(CPPHTTPLIB_LIBRARY
         NAMES cpp-httplib libcpp-httplib.so
-        PATHS /usr/lib64 /usr/lib
+        PATHS /usr/lib64 /usr/lib /usr/lib/aarch64-linux-gnu
         NO_DEFAULT_PATH
 )
 
@@ -16,6 +16,7 @@ if((NOT CPPHTTPLIB_INCLUDE_DIR OR NOT CPPHTTPLIB_LIBRARY) AND NOT SOURCE_COMPILI
 endif()
 
 if (SOURCE_COMPILING)
+    include(FetchContent)
     set(CPPHTTPLIB_REPO "https://gitcode.com/GitHub_Trending/cp/cpp-httplib.git")
     set(CPPHTTPLIB_TAG "v0.40.0")
     FetchContent_Declare(
diff --git a/3rdparty/hcom/CMakeLists.txt b/3rdparty/hcom/CMakeLists.txt
index 34421c90..737a72b0 100644
--- a/3rdparty/hcom/CMakeLists.txt
+++ b/3rdparty/hcom/CMakeLists.txt
@@ -9,48 +9,13 @@ find_library(HCOM_SHARED_LIBRARY
         NO_DEFAULT_PATH
 )
 
-if ((NOT HCOM_INCLUDE_DIR OR NOT HCOM_SHARED_LIBRARY) AND NOT SOURCE_COMPILING)
+if (NOT HCOM_INCLUDE_DIR OR NOT HCOM_SHARED_LIBRARY)
     message(FATAL_ERROR "hcom not found! Please execute:
                 sudo yum install 'ubs-comm-devel >= 1.0.1-7'")
 endif()
 
-if (SOURCE_COMPILING)
-    include(FetchContent)
-
-    # ubs-comm 仓库包含 hcom 的实现
-    FetchContent_Declare(
-            ubs_comm
-            GIT_REPOSITORY https://gitcode.com/openeuler/ubs-comm.git
-            GIT_TAG master
-    )
-
-    # 只下载不构建
-    FetchContent_GetProperties(ubs_comm)
-
-    if(NOT ubs_comm_POPULATED)
-        FetchContent_Populate(ubs_comm)  # 只下载
-        message(STATUS "Downloaded ubs_comm to: ${ubs_comm_SOURCE_DIR}")
-    endif()
-
-    # 构建hcom
-    set(HCOM_DIST ${ubs_comm_SOURCE_DIR}/dist/hcom)
-    set(HCOM_LIB ${HCOM_DIST}/lib/libhcom.so)
-
-    add_custom_command(OUTPUT ${HCOM_LIB}
-            COMMAND env HCOM_BUILD_UB=on HCOM_BUILD_RDMA=off bash build.sh
-            WORKING_DIRECTORY ${ubs_comm_SOURCE_DIR}
-            VERBATIM
-    )
-    add_custom_target(build_hcom ALL DEPENDS ${HCOM_LIB})
-
-    add_library(hcom INTERFACE)
-    target_include_directories(hcom SYSTEM INTERFACE ${HCOM_DIST}/include)
-    target_link_libraries(hcom INTERFACE ${HCOM_LIB})
-    add_dependencies(hcom build_hcom)
-elseif ()
-    add_library(hcom INTERFACE)
-    target_include_directories(hcom SYSTEM INTERFACE ${HCOM_INCLUDE_DIR})
-    target_link_libraries(hcom INTERFACE ${HCOM_SHARED_LIBRARY})
-endif ()
+add_library(hcom INTERFACE)
+target_include_directories(hcom SYSTEM INTERFACE ${HCOM_INCLUDE_DIR})
+target_link_libraries(hcom INTERFACE ${HCOM_SHARED_LIBRARY})
 
 message(STATUS "Found hcom: ${HCOM_INCLUDE_DIR}, ${HCOM_SHARED_LIBRARY}")
\ No newline at end of file
-- 
